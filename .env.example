# ── Bribe Desk ─────────────────────────────────────────────
# Copy to .env.local for local dev; set the same in Vercel → Settings → Environment Variables.
# Everything is optional except KITCHEN_KEY in production. Without Supabase the app keeps
# data in .data/db.json locally (and in memory on Vercel, which resets).

SITE_URL=https://treat.chandumachineni.com

# Your /kitchen passphrase (statuses, sweets received, board, work). Long and random.
KITCHEN_KEY=

# Calendar: Google Calendar → Settings → your calendar → Integrate calendar →
# "Secret address in iCal format". Titles from this one are NEVER shown, only Busy / Focus / Out.
ICS_PRIVATE_URL=
# Optional second calendar whose event titles ARE shown on the page (e.g. a "Bribe Desk" calendar).
ICS_PUBLIC_URL=
# Your email, so events you declined don't show as busy.
CAL_EMAIL=

# Supabase (new project, nothing from Forge). Run supabase/schema.sql once.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Same project, for live cursors (Realtime broadcast/presence only; tables stay locked).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# New-token alerts. WhatsApp via CallMeBot (free, to your own number):
CALLMEBOT_PHONE=
CALLMEBOT_KEY=
# Optional extras
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Optional bot check (Cloudflare Turnstile, invisible unless suspicious)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing visitor IPs (rate limit: 5 tokens a day per IP)
IP_SALT=
